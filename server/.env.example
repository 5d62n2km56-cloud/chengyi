# 复制成 .env；scripts/bootstrap.py 会生成本地管理员密码和签名密钥。
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/heritage.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SECRET_KEY=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SEED_DEMO_DATA=true

# demo 不需要 Key；联调真实模型时改成 live，并填写下面三个配置。
LLM_MODE=demo
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=1200
# 模型故障时改用资料讲解，并在返回中明确标记 fallback。
LLM_FALLBACK_ENABLED=true
LLM_PROVIDER='dify'
SPEECH_ENABLED='false'
SPEECH_API_KEY=''
SPEECH_VOICE='anna'
SPEECH_TIMEOUT_SECONDS='45'
